{
  "manifest_version": "0.3",
  "name": "mathcraft",
  "display_name": "Mathcraft",
  "version": "@VERSION@",
  "description": "Lets Claude read, edit, calculate, plot and save Mathcraft worksheets (.mcdx) in a folder you choose.",
  "author": {
    "name": "The Mathcraft contributors"
  },
  "icon": "icon.png",
  "license": "MIT OR Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "server/mathcraft-mcp",
    "mcp_config": {
      "command": "${__dirname}/server/mathcraft-mcp",
      "args": ["--root", "${user_config.documents_folder}"],
      "platform_overrides": {
        "win32": {
          "command": "${__dirname}/server/mathcraft-mcp.exe"
        }
      }
    }
  },
  "user_config": {
    "documents_folder": {
      "type": "directory",
      "title": "Documents folder",
      "description": "The folder Claude may open and save worksheets in. Claude cannot touch files outside it.",
      "required": true,
      "default": "${DOCUMENTS}"
    }
  }
}
